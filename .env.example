# sitemap, structured data). Must NOT have a trailing slash.
NEXT_PUBLIC_SITE_URL=https://www.aureadental.com

# Search engine verification codes (leave empty until provisioned).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Analytics / tracking identifiers (leave empty until provisioned).
NEXT_PUBLIC_GA_MEASUREMENT_ID=
